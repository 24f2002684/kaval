# KAVAL Environment Configuration
# Hackathon: CipherCop 2026 | Team: The G.O.A.T.

ENV=development
PROJECT_NAME="KAVAL – AI Flood Intelligence & Disaster Response"
SECRET_KEY=kaval_super_secret_jwt_key_ciphercop_2026_goat_resilience
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite is default for zero-config instant start; PostgreSQL / PostGIS supported for Docker
DATABASE_URL=sqlite:///./kaval.db
# DATABASE_URL=postgresql://kaval_user:kaval_secure_password_2026@localhost:5432/kaval

# Pilot Cities
DEFAULT_CITY=Chennai

# AI / LLM Configuration (Optional: Deterministic tool orchestrator fallback is always active)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Open-Meteo Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
